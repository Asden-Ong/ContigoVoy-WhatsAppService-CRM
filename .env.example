NODE_ENV=production
PORT=3001
# Dominios del frontend que consumen el QR
ALLOWED_ORIGINS=https://crm.tudominio.com

# --- Conexion con el CRM ----------------------------------------------------

# Donde vive el CRM. Lo usa syncOutgoingMessageToCRM() para registrar alli las
# respuestas que envia el bot. Tiene que ser una direccion alcanzable DESDE
# ESTE proceso: http://localhost:3000, el nombre del servicio en Docker, o el
# dominio publico si estan en maquinas distintas.
CRM_URL=http://localhost:3000

# Credencial para hablar con la API del CRM entre servidores. DEBE valer
# exactamente lo mismo que INTERNAL_API_KEY en el .env del CRM: su proxy
# compara las dos y, si no coinciden, responde 401 y la respuesta del bot nunca
# queda guardada (el cliente si la recibe, el CRM no se entera).
# Genera una con:
#   openssl rand -hex 32
INTERNAL_API_KEY=

# --- Chatbot de n8n ---------------------------------------------------------

# URL del webhook de n8n al que se reenvia cada mensaje entrante CON TEXTO
# (sendToN8n en src/services/whatsapp.service.js). Vacio = no se avisa a n8n y
# el bot queda apagado; el CRM sigue funcionando igual.
# El flujo de n8n responde llamando de vuelta a este servicio:
#   POST {este servicio}/api/whatsapp/send-message
#   { "jid": "...", "message": "...", "n8n": true }
# Ese `n8n: true` es lo que dispara la sincronizacion con el CRM.
TRIGGER_N8N_URL=
